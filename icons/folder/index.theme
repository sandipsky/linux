# Yaru's orange folder icons (the ones Ubuntu's Files shows) on top of
# Adwaita. Only the folder icons live here — everything else falls through
# to Adwaita via Inherits. The PNGs are copied unchanged from the Yaru icon
# theme (yaru-theme-icon, GPL-3.0 / CC BY-SA 4.0), places/ context only.
# hyprland.sh installs this directory as /usr/share/icons/Yaru-folders and
# selects it as the icon theme.
[Icon Theme]
Name=Yaru-folders
Comment=Yaru folder icons over Adwaita
Inherits=Adwaita,hicolor
Example=folder
Directories=16x16/places,16x16@2x/places,24x24/places,24x24@2x/places,32x32/places,32x32@2x/places,48x48/places,48x48@2x/places,256x256/places,256x256@2x/places

[16x16/places]
Context=Places
Size=16
Type=Fixed

[16x16@2x/places]
Context=Places
Scale=2
Size=16
Type=Fixed

[24x24/places]
Context=Places
Size=24
Type=Fixed

[24x24@2x/places]
Context=Places
Scale=2
Size=24
Type=Fixed

[32x32/places]
Context=Places
Size=32
Type=Fixed

[32x32@2x/places]
Context=Places
Scale=2
Size=32
Type=Fixed

[48x48/places]
Context=Places
Size=48
Type=Fixed

[48x48@2x/places]
Context=Places
Scale=2
Size=48
Type=Fixed

[256x256/places]
Context=Places
Size=256
MinSize=64
MaxSize=256
Type=Scalable

[256x256@2x/places]
Context=Places
Scale=2
Size=256
MinSize=64
MaxSize=256
Type=Scalable
